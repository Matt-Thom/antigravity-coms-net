{
  "name": "antigravity-coms-net",
  "version": "0.1.0",
  "type": "module",
  "description": "Antigravity CLI integration for coms-net multi-agent mesh",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "coms-net-bridge": "./bin/coms-net-bridge.js",
    "coms-net-mcp": "./bin/coms-net-mcp.js"
  },
  "files": [
    "dist",
    "bin",
    ".agents/plugins"
  ],
  "scripts": {
    "build": "tsc",
    "bridge": "tsx src/cli.ts",
    "mcp": "tsx src/mcp/server.ts",
    "validate:plugin": "agy plugin validate .agents/plugins/coms-net",
    "test": "node --test --experimental-strip-types tests/unit/*.test.ts tests/integration/*.test.ts tests/adversarial/*.test.ts tests/e2e/*.test.ts",
    "test:unit": "node --test --experimental-strip-types tests/unit/*.test.ts",
    "test:integration": "node --test --experimental-strip-types tests/integration/*.test.ts",
    "test:adversarial": "node --test --experimental-strip-types tests/adversarial/*.test.ts",
    "test:e2e": "node --test --experimental-strip-types tests/e2e/*.test.ts",
    "test:all": "node --test --experimental-strip-types tests/unit/*.test.ts tests/integration/*.test.ts tests/adversarial/*.test.ts tests/e2e/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
